SHELL=/bin/sh
TZ=Asia/Tokyo

# Market Signal Lab on Raspberry Pi. All times are JST.
# flock prevents overlapping executions when a previous API call is still running.
10 6 * * 1-5 mkdir -p /home/tsurusumu/market-signal-lab/ops_logs && flock -n /tmp/market-signal-lab-fred.lock sh -c 'cd /home/tsurusumu/market-signal-lab && docker compose exec -T app python jobs/collect_us_market.py' >> /home/tsurusumu/market-signal-lab/ops_logs/collect_us_market.log 2>&1
30 7 * * 1-5 mkdir -p /home/tsurusumu/market-signal-lab/ops_logs && flock -n /tmp/market-signal-lab-short-analysis.lock sh -c 'cd /home/tsurusumu/market-signal-lab && docker compose exec -T app python jobs/run_short_term_analysis.py' >> /home/tsurusumu/market-signal-lab/ops_logs/run_short_term_analysis.log 2>&1
0 23 * * * mkdir -p /home/tsurusumu/market-signal-lab/ops_logs && flock -n /tmp/market-signal-lab-backup.lock sh -c 'cd /home/tsurusumu/market-signal-lab && docker compose exec -T app python jobs/backup_database.py' >> /home/tsurusumu/market-signal-lab/ops_logs/backup_database.log 2>&1
45 5 * * * mkdir -p /home/tsurusumu/market-signal-lab/ops_logs && flock -n /tmp/market-signal-lab-operations.lock sh -c 'cd /home/tsurusumu/market-signal-lab && docker compose exec -T app python jobs/check_operations.py; status=$$?; if [ $$status -eq 2 ]; then docker compose restart jquants-collector; fi; exit $$status' >> /home/tsurusumu/market-signal-lab/ops_logs/check_operations.log 2>&1
